// MediConnect data model.
// NOTE: the double-booking guard (partial unique indexes), CHECK constraints and the
// queue_position invariant live in the migration SQL because Prisma's schema language
// cannot express partial indexes or CHECKs. See prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  doctor
  admin
}

enum AppointmentStatus {
  booked
  in_queue
  in_progress
  completed
  cancelled
}

enum NotificationType {
  appointment_confirmed
  appointment_cancelled
  appointment_reminder
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(patient)
  createdAt    DateTime @default(now()) @map("created_at")

  doctorProfile DoctorProfile?
  appointments  Appointment[]  @relation("PatientAppointments")
  messages      Message[]
  notifications Notification[]
}

model DoctorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  specialty   String
  bio         String   @default("")
  // Average of patient ratings (0-5), recomputed transactionally when a rating is submitted.
  rating      Float    @default(0)
  ratingCount Int      @default(0) @map("rating_count")
  // Inactive doctors are hidden from discovery and cannot receive new bookings.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability AvailabilitySlot[]
  appointments Appointment[]

  @@index([specialty])
  @@index([isActive, rating(sort: Desc), id])
}

// Weekly recurring availability window, interpreted in CLINIC_TIMEZONE.
// dayOfWeek: 0 = Sunday ... 6 = Saturday. startTime/endTime: "HH:mm" (24h).
model AvailabilitySlot {
  id        String @id @default(cuid())
  doctorId  String @map("doctor_id")
  dayOfWeek Int    @map("day_of_week")
  startTime String @map("start_time")
  endTime   String @map("end_time")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([dayOfWeek])
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String            @map("patient_id")
  doctorId       String            @map("doctor_id")
  slotStart      DateTime          @map("slot_start")
  slotEnd        DateTime          @map("slot_end")
  status         AppointmentStatus @default(booked)
  // 1-based position among the doctor's in_queue appointments; non-null iff status = in_queue.
  queuePosition  Int?              @map("queue_position")
  reason         String?
  // Doctor's clinical notes; never exposed to the patient-facing UI.
  notes          String?
  // Patient rating (1-5) of a completed consultation.
  rating         Int?
  checkedInAt    DateTime?         @map("checked_in_at")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  cancelledAt    DateTime?         @map("cancelled_at")
  cancelledBy    Role?             @map("cancelled_by")
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  patient       User           @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id])
  messages      Message[]
  notifications Notification[]

  @@index([patientId])
  @@index([doctorId, slotStart])
  @@index([status, slotStart])
}

model Message {
  id            String    @id @default(cuid())
  appointmentId String    @map("appointment_id")
  senderId      String    @map("sender_id")
  body          String
  sentAt        DateTime  @default(now()) @map("sent_at")
  readAt        DateTime? @map("read_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id])

  @@index([appointmentId, sentAt])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  type          NotificationType
  title         String
  body          String
  appointmentId String?          @map("appointment_id")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}
