# --- Database (local Postgres, passwordless dev user; adjust for your machine) ---
DATABASE_URL="postgresql://dev@localhost:5432/mediconnect?schema=public"
# Used by Vitest integration tests only. Tables are truncated between tests: never point this at real data.
TEST_DATABASE_URL="postgresql://dev@localhost:5432/mediconnect_test?schema=public"
# Used by Playwright e2e only (reset + seeded on every run).
E2E_DATABASE_URL="postgresql://dev@localhost:5432/mediconnect_e2e?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

# --- App ---
# Own port so MediConnect never collides with other local projects (e2e uses PORT+1).
PORT=3100
# IANA timezone in which doctor availability windows ("09:00") are interpreted and displayed.
CLINIC_TIMEZONE="UTC"
# Booking policy (minutes)
SLOT_MINUTES=30
BOOKING_LEAD_MINUTES=15
CHECKIN_OPENS_MINUTES=60
REMINDER_LEAD_MINUTES=30
# In-process reminder scan cadence (seconds). In multi-instance prod, run the scan from one cron worker instead.
REMINDER_SCAN_INTERVAL_SECONDS=60
